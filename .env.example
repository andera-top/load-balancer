PORT=4000
REDIS_HOST=redis
REDIS_PORT=6379
# Required: generate with `openssl rand -hex 32`, and use the same value as LB_AUTH_KEY on every Worker.
LB_AUTH_KEY=
WORKER_DISCOVERY_INTERVAL=3000
WORKER_DISCOVERY_TIMEOUT=3000
WORKER_DISCOVERY_RETRIES=10
WS_HEARTBEAT_INTERVAL=3000
WS_HEARTBEAT_TIMEOUT=3000
DASHBOARD_ENABLED=true
BULL_BOARD_ENABLED=true
LOG_LEVEL=info
MAX_LOGS=1000
TASK_TIMEOUT=300000
TASK_ATTEMPTS=3
REQUEST_BODY_LIMIT=10mb

# Optional MCP: keep empty to disable; use a distinct random token (e.g. openssl rand -hex 32).
MCP_AUTH_KEY=
MCP_CONFIG_PATH=mcp.json
# Browser origins only; native clients do not need this.
MCP_ALLOWED_ORIGINS=
# Referenced by mcp.example.json; must match AUTH_KEY on default/1 Workers.
DEFAULT_WORKER_AUTH_KEY=
